---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format Arabic Date
const formatDate = (dateString: string) => {
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('ar-EG', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch (e) {
    return dateString;
  }
};
---

<Layout title={post.data.title} description={post.data.description} image={post.data.coverImage}>
  <Header />
  
  <main class="post-main container fade-in">
    <a href="/" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
      <span>العودة للرئيسية</span>
    </a>
    
    <article class="post-article">
      <header class="article-header">
        <div class="post-meta">
          <time datetime={post.data.publishDate}>{formatDate(post.data.publishDate)}</time>
        </div>
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.description && <p class="article-desc">{post.data.description}</p>}
      </header>
      
      {post.data.coverImage && (
        <div class="article-cover-container">
          <img src={post.data.coverImage} alt={post.data.title} class="article-cover" />
        </div>
      )}
      
      <div class="article-content">
        <Content />
      </div>
    </article>
  </main>
  
  <Footer />
</Layout>

<style>
  .post-main {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-accent);
    margin-bottom: 2rem;
    font-weight: 600;
  }
  
  .back-link svg {
    transition: var(--transition);
  }
  
  .back-link:hover svg {
    transform: translateX(4px);
  }
  
  .post-article {
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: var(--shadow-md);
  }
  
  .article-header {
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .post-meta {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  
  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }
  
  .article-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .article-cover-container {
    width: 100%;
    max-height: 450px;
    overflow: hidden;
    border-radius: 12px;
    margin-bottom: 3rem;
    border: 1px solid var(--color-border);
  }
  
  .article-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: var(--transition);
  }
  
  /* Styling markdown content output */
  .article-content {
    font-size: 1.15rem;
    line-height: 2;
    color: var(--color-text-primary);
    text-align: justify;
  }
  
  .article-content :global(p) {
    margin-bottom: 1.75rem;
    /* Markdown keeps a soft line break as a newline in the output HTML, which the
       browser would otherwise collapse to a space. The CMS editor can only write
       soft breaks, so honour them as real line breaks. */
    white-space: pre-line;
  }
  
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    color: var(--color-text-primary);
    font-weight: 700;
    text-align: right;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
  }
  
  .article-content :global(h2) {
    font-size: 1.8rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }
  
  .article-content :global(h3) {
    font-size: 1.5rem;
  }

  .article-content :global(h4) {
    font-size: 1.3rem;
  }
  
  .article-content :global(blockquote) {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 2;
    text-align: center;
    margin: 2.5rem 0;
    padding: 1.5rem 2rem;
    background-color: rgba(var(--color-accent-rgb), 0.05);
    border-right: 4px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-text-primary);
    position: relative;
    overflow: hidden;
  }
  
  .article-content :global(ul), .article-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-right: 2rem;
    text-align: right;
  }
  
  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  /* Code blocks & Inline code */
  .article-content :global(pre) {
    direction: ltr;
    text-align: left;
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    margin: 1.75rem 0;
    overflow-x: auto;
    background-color: #1a2018 !important;
  }

  .article-content :global(code) {
    font-family: Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace;
    font-size: 0.9em;
  }

  .article-content :global(p code) {
    background-color: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-accent);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    direction: ltr;
    display: inline-block;
  }

  /* Tables styling */
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 1rem;
    text-align: right;
  }

  .article-content :global(th) {
    background-color: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-accent);
    font-weight: 700;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .article-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .article-content :global(tr:nth-child(even)) {
    background-color: rgba(var(--color-accent-rgb), 0.02);
  }
 
  @media (max-width: 768px) {
    .post-article {
      padding: 1.5rem;
    }
    
    .article-title {
      font-size: 1.8rem;
    }
  }
</style>
