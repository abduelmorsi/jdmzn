---
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-container">
    <p class="footer-tagline">لَمْلَمَةُ شَعَث، وَشَيْءٌ مِنَ التَّحَلُّم.</p>
    <div class="footer-links">
      <a href="/">الرئيسية</a>
      <a href="https://t.me/jdmzn" target="_blank" rel="noopener noreferrer">قناتي على تليجرام</a>
    </div>
    <p class="copyright">
      &copy; {currentYear} سَنَا صَعْب. جميع الحقوق محفوظة.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 3rem 0;
    margin-top: auto;
    background-color: #efebe0;
    color: var(--color-text-muted);
    text-align: center;
  }
  
  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  
  .footer-tagline {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-text-primary);
  }
  
  .footer-links {
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }
  
  .footer-links a {
    color: var(--color-text-muted);
  }
  
  .footer-links a:hover {
    color: var(--color-accent);
  }
  
  .copyright {
    font-size: 0.8rem;
    opacity: 0.6;
  }
</style>
