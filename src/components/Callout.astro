---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'danger';
  title?: string;
}

const { type = 'info', title } = Astro.props;
---

<div class={`callout callout-${type}`}>
  {title && <div class="callout-title">{title}</div>}
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    padding: 1.25rem 1.5rem;
    margin: 1.75rem 0;
    border-radius: 8px;
    border-right: 4px solid var(--color-accent);
    background-color: rgba(216, 150, 135, 0.05);
    font-size: 1rem;
    line-height: 1.7;
  }
  
  .callout-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .callout-success {
    border-right-color: #87d8a6;
    background-color: rgba(135, 216, 166, 0.05);
  }
  .callout-success .callout-title {
    color: #87d8a6;
  }

  .callout-warning {
    border-right-color: #d8c287;
    background-color: rgba(216, 194, 135, 0.05);
  }
  .callout-warning .callout-title {
    color: #d8c287;
  }

  .callout-danger {
    border-right-color: #d88787;
    background-color: rgba(216, 135, 135, 0.05);
  }
  .callout-danger .callout-title {
    color: #d88787;
  }
</style>
