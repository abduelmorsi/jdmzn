---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const links = [
  {
    label: 'تليجرام',
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
    path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  },
  {
    label: 'واتساب',
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  },
  {
    label: 'إكس',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  },
];
---

<div class="share" data-share-title={title} data-share-url={url}>
  <span class="share-label">شارك التدوينة</span>
  <div class="share-buttons">
    <button type="button" class="share-btn share-native" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M12 16V3m0 0L8 7m4-4 4 4"/></svg>
      <span>مشاركة</span>
    </button>

    {links.map((link) => (
      <a class="share-btn" href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`مشاركة على ${link.label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d={link.path} /></svg>
        <span>{link.label}</span>
      </a>
    ))}

    <button type="button" class="share-btn share-copy">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      <span class="copy-text">نسخ الرابط</span>
    </button>
  </div>
</div>

<script>
  // Runs on every view transition, so bind per-element rather than once per page load.
  const setup = () => {
    document.querySelectorAll<HTMLElement>('.share').forEach((share) => {
      if (share.dataset.bound) return;
      share.dataset.bound = 'true';

      const title = share.dataset.shareTitle ?? document.title;
      const url = share.dataset.shareUrl ?? location.href;

      const nativeBtn = share.querySelector<HTMLButtonElement>('.share-native');
      if (nativeBtn && typeof navigator.share === 'function') {
        nativeBtn.hidden = false;
        nativeBtn.addEventListener('click', async () => {
          // AbortError just means the user dismissed the sheet.
          try {
            await navigator.share({ title, url });
          } catch (err) {
            if ((err as Error)?.name !== 'AbortError') console.error(err);
          }
        });
      }

      const copyBtn = share.querySelector<HTMLButtonElement>('.share-copy');
      const copyText = copyBtn?.querySelector('.copy-text');
      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          if (!copyText) return;
          copyText.textContent = 'تم النسخ';
          setTimeout(() => { copyText.textContent = 'نسخ الرابط'; }, 2000);
        } catch {
          // Clipboard needs a secure context; fall back to letting the reader copy it.
          window.prompt('انسخ الرابط', url);
        }
      });
    });
  };

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .share {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .share-label {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition);
  }

  .share-btn:hover,
  .share-btn:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: rgba(var(--color-accent-rgb), 0.06);
  }

  .share-btn svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .share-btn svg.filled {
    fill: currentColor;
    stroke: none;
    /* Brand marks are solid and reach the edge of the viewBox, unlike the inset
       outline icons, so trim them slightly to match optically. */
    width: 15px;
    height: 15px;
  }

  @media (max-width: 480px) {
    .share-btn span { display: none; }
    .share-btn { padding: 0.7rem; }
    .share-native span { display: inline; }
  }
</style>
